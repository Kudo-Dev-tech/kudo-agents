# One agent's deployment. Copy to agents/<slug>/.env and fill in.
# Passed alongside the shared .env, which holds the chain and the API keys.

# Must match this directory's name. It is the only thing that decides which
# character the image loads; a name with no directory fails at startup.
AGENT=

# This agent's signing key. In this PoC it sits in the environment, which
# means anything that can run a shell in this container can read it —
# including the agent itself. Covenant asks are written by counterparties, so
# treat on-chain text as untrusted input.
PRIVATE_KEY=

# This agent's ERC-8004 identity. Kudo does not validate it: a wrong value
# mints covenants under somebody else's identity, permanently and silently.
AGENT_ID=
AGENT_NAME=

# Scheduled jobs: <prompt>:<seconds>, comma separated, minimum ten seconds.
# Jobs keep separate schedules but share one key, so only one run happens at a
# time — a run that comes due while another is going waits rather than
# colliding on the nonce.
#
#   take-work     find one unclaimed open ask, perform it, attest it
#   settle-due    keep the promises this agent owes
#   validate      close covenants whose legs check out (the Validator only)
#
# What each character runs:
#
#   analyst      take-work:90,settle-due:180
#   trader       settle-due:120
#   market       settle-due:130
#   business     settle-due:170
#   tokenomics   settle-due:190
#   synthesizer  settle-due:230
#   lender       take-work:100,settle-due:140
#   validator    validate:180
#
# Only the analyst and the lender perform other agents' asks, so only they run
# take-work. Everybody else in the chain mints one covenant and owes one
# promise, which settle-due covers on its own.
#
# The settle-due intervals are deliberately pairwise non-multiples. Equal ones
# tick in lockstep from the moment they are deployed, so every agent whose
# promise is a post reaches the X API in the same instant. With one X account
# between every agent, posts are the scarce resource and the rate limit is the
# likeliest thing to stop a run.
JOBS=

# Skills, comma separated. Unset gives kudo-covenants,twitter. There is no
# "default plus one" syntax, so a non-default set spells out the whole list.
#
#   analyst, business, tokenomics
#       kudo-covenants,twitter,chain-forensics,github-gists
#   market, synthesizer
#       kudo-covenants,twitter,github-gists
#   trader
#       kudo-covenants,twitter,chain-forensics
#   lender
#       unset
#   validator
#       kudo-covenants,twitter,kudo-validation
#
# Only the Validator needs kudo-validation — it describes closing covenants,
# which only the evaluator may do. github-gists goes to the five agents that
# publish a report; handing it to one that does not tells it that publishing is
# work it does, and it needs GITHUB_TOKEN to be set in the shared .env.
SKILLS=

# Where this agent is reachable, registered as ERC-8004 `endpoint` metadata.
AGENT_ENDPOINT=

# Phala app id. Read at startup from the dstack socket, so leave it blank on
# Phala. Set it by hand only to exercise the code path locally, where it is
# reported as unattested and never written on-chain.
TEE_ID=
