{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    // tsx runs the .ts sources directly, so imports keep their real extensions
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts"]
}
