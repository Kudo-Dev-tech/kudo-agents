# Shared by every agent. Copy to .env and fill in.
#
# Config is split in two:
#
#   .env                  this file — the chain, the token, the API keys
#   agents/<slug>/.env    that agent's identity, key, jobs and skills
#
# A deployment passes both, and `phala deploy` takes -e more than once:
#
#   phala deploy --compose docker-compose.yml --name vale \
#     -e .env -e agents/vale/.env --wait
#
# Nothing agent-specific belongs here. If a value differs between Vale and
# Kit, it goes in their directory instead.

ANTHROPIC_API_KEY=

# --- Robinhood Chain testnet (chainId 46630) ---
# The research chain runs here: USDG exists on testnet only.
RPC_URL=https://rpc.testnet.chain.robinhood.com
KUDO=0x7021279517a7b301b8d10eD9c3b9F73C101146f1
IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e

# --- Robinhood Chain mainnet (chainId 4663) ---
# RPC_URL=https://rpc.mainnet.chain.robinhood.com
# KUDO=0xc269c6176f3418A84FCdA5911723B0d358971351
# IDENTITY_REGISTRY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432

# --- Settlement token and the Vault (testnet only) ---
# USDG is a mock ERC-20 with six decimals, so 1 USDG is 1000000 base units. It
# has an open mint and no value. ETH is for gas only and is never what a
# promise is denominated in.
USDG=0xc44DB72f7d3185b6AAA7907434592EB7689D0100
VAULT=0xD0dF7F58B73a8003BFAc57AaCb4F4eFf6392d2D4

# --- X / Twitter ---
# All four are required. If any is missing the request goes out unsigned and X
# answers 403 "Authenticating with Unknown", which reads like a permissions
# problem but is not.
#
# The access token must be read-write. Setting the app to "Read and write" in
# the developer portal is not enough — regenerate the access token and secret
# afterwards, or the old token keeps its read-only permission.
#
# Every agent currently shares one account, so posts from different characters
# are indistinguishable by author.
TWITTER_API_KEY=
TWITTER_API_SECRET_KEY=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_HANDLE=

# --- GitHub (publishing reports) ---
# One token, and the smallest one that does the job: a classic PAT with the
# `gist` scope and nothing else, or a fine-grained PAT with Account
# permissions → Gists: read and write and no repository access. It must not be
# able to reach a repository — this agent has a shell and can read its own
# environment, so assume the token is as exposed as the signing key.
#
# Fine-grained tokens expire, a year at most. An expired one is a loop that
# fails every few minutes with nothing else looking wrong, so note the date.
#
# Reports are published as public gists and the attested URL is the raw
# revision URL, which cannot change after a validator reads it. The agents
# that publish share one account, as they share one X account.
#
# Only needed by agents whose SKILLS include github-gists; startup warns when
# one of those has no token rather than failing mid-report.
GITHUB_TOKEN=
