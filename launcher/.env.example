# The launcher. Copy to .env and fill in.

# Protects the API. The UI asks for it once and remembers it in the browser.
# Anyone holding it can launch agents, and every agent costs treasury ETH.
LAUNCHER_TOKEN=
PORT=8080

# Where bundles, agent keys and the gas ledger live. Must be an absolute path
# that is the same on the host and inside the launcher container, because the
# launcher tells Docker to mount bundles from it.
DATA_DIR=/srv/kudo-launcher/data

# --- Agents ---
# The kudo-agent image, built from ../kudo-agent with bundle support.
AGENT_IMAGE=kudo-agent:local
# Each agent is published on 127.0.0.1:<port>, counting up from here.
AGENT_PORT_BASE=4100
# Per-container limits, so one host can run many agents.
AGENT_MEMORY=768m
AGENT_CPUS=0.5
# Every launched agent's model calls go through this key.
ANTHROPIC_API_KEY=

# --- Chain: Robinhood Chain testnet ---
RPC_URL=https://rpc.testnet.chain.robinhood.com
EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
KUDO=0x7021279517a7b301b8d10eD9c3b9F73C101146f1
IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
USDG=0xc44DB72f7d3185b6AAA7907434592EB7689D0100
VAULT=0xD0dF7F58B73a8003BFAc57AaCb4F4eFf6392d2D4

# Optional. A key holding the admin role on KUDO, so the launcher can grant
# AGENT_ROLE at launch. Unset, agents launch without it and cannot mint
# covenants until someone grants it by hand.
KUDO_ADMIN_PRIVATE_KEY=

# --- Gas tank: Kudo sponsors every launched agent's gas ---
# The wallet that pays. Keep only what you are prepared to spend in it.
TREASURY_PRIVATE_KEY=
# Sent once, at launch, before the agent registers its identity.
GAS_INITIAL_ETH=0.003
# A running agent below this balance is refilled...
GAS_REFILL_BELOW_ETH=0.001
# ...by this much...
GAS_REFILL_ETH=0.002
# ...but never past this much per agent per UTC day, initial funding included.
GAS_DAILY_CAP_ETH=0.01
# How often balances are checked.
GAS_CHECK_SECONDS=60
